# ============================================
# .gitignore para RPG Maker MZ
# Projeto: Huwag
# ============================================

# === Saves de Jogo (RPG Maker MZ) ===
# Saves locais nunca devem ser versionados para não sobrepor o progresso de outros
save/
Save/
*.rmmzsave
Save*.rmmzsave
config.rmmzsave
global.rmmzsave
www/save/
*.rpgsave

# === Builds e Exportações (Deployment do RMMZ) ===
# Builds compiladas geradas via "Arquivo -> Deployment"
output/
deployment/
build/
dist/
www/
Game.exe
*.zip
*.rar
*.7z
*.tar.gz

# === Backups e Temporários do RPG Maker ===
Backup/
backup/
*.backup
*.tmp
*.log
*.cache
*~

# === Node & Dependências (se usar ferramentas externas) ===
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Arquivos de Sistema Operacional ===
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory

# === IDEs e Editores ===
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

